# TimeTracker — miljövariabler / hemligheter
# Inga riktiga värden här. Sätt dem i Cloudflare (wrangler secret put) eller i Supabase när systemet flyttas.

# ---- Server / API (Cloudflare Worker: src/server/wrangler.toml) ----
# Brevo transaktions-API-nyckel för verifierings- och återställningsmejl. Hemlig: `npx wrangler secret put BREVO_API_KEY`
BREVO_API_KEY=<your-brevo-api-key-here>
# Avsändare som är verifierad i Brevo. Vanlig variabel i wrangler.toml [vars].
MAIL_FROM_EMAIL=noreply@example.com
MAIL_FROM_NAME=TimeTracker
# Kommaseparerad lista över e-postadresser som ALLTID är admin. Hemlig: `npx wrangler secret put ADMIN_EMAILS`.
# Om den saknas behåller servern rollerna som redan står i databasen.
ADMIN_EMAILS=chef@example.com,lead@example.com

# ---- Cloudflare-bindningar (inte env-variabler utan resurser i wrangler.toml) ----
# DB    = D1-databas (SQLite)   → database_id sätts i wrangler.toml
# SHOTS = R2-bucket för skärmbilder → bucket_name sätts i wrangler.toml

# ---- Klienter (hårdkodade konstanter, byt vid flytt) ----
# Mac-app:  src/mac-app/Sources/Session.swift  → defaultAPIBaseURL
# Desktop:  src/desktop-client/main.js        → API, WEBSITE
# Webb:     src/web/index.html                → API, GITHUB_REPO
API_BASE_URL=https://timetracker-api.example.workers.dev
WEBSITE_URL=https://timetracker.example.pages.dev
GITHUB_REPO=org/timetracker

# ---- GitHub Actions (src/desktop-client/github-workflow-build.yml) ----
# GITHUB_TOKEN tillhandahålls automatiskt av Actions; inget att sätta. Kodsignering är avstängd (CSC_IDENTITY_AUTO_DISCOVERY=false).
